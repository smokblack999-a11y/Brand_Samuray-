# SAMURAI Payments Engine — disabled by default
PAYMENTS_ENABLED=false
PAYMENTS_MODE=disabled
PAYMENTS_PROVIDER=disabled

# Isolated Stripe sandbox only. Keep actual values in a secret manager / local .env.
# To explicitly enable a local test run, set PAYMENTS_ENABLED=true,
# PAYMENTS_MODE=test, and PAYMENTS_PROVIDER=stripe_test.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# The application must supply fixed, trusted redirect URLs.
PAYMENTS_SUCCESS_URL=
PAYMENTS_CANCEL_URL=

# Never put live credentials in this template or commit secrets.
