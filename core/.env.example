PORT=8787
NODE_ENV=production
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT_MS=20000
MAX_MESSAGE_CHARS=4000
REQUEST_TIMEOUT_MS=30000
LEAD_RATE_LIMIT_WINDOW_MS=60000
LEAD_RATE_LIMIT_MAX=20
TRUST_PROXY=false
TELEGRAM_BOT_TOKEN=
TELEGRAM_TIMEOUT_MS=10000
TELEGRAM_WEBHOOK_URL=https://YOUR-DOMAIN.example.com/api/telegram/webhook
TELEGRAM_WEBHOOK_SECRET=replace-with-random-secret
CORE_API_KEY=replace-with-admin-api-key
# Separate secret used only to validate GitHub webhook signatures.
AGENT_CONTROL_WEBHOOK_SECRET=replace-with-a-different-random-secret
# Fine-grained GitHub token: Actions read + Attestations read for this repository.
GH_TOKEN=replace-with-repository-scoped-token
# Put DATA_DIR and NEXUS_EVIDENCE_DIR on persistent storage in production.
DATA_DIR=./data
NEXUS_EVIDENCE_DIR=./data/nexus-evidence
BUSINESS_NAME=Your Business
AUTO_REPLY=false
CORS_ORIGIN=
DUAL_AI_TIMEOUT_MS=30000
DUAL_AI_MAX_ROUNDS=3
DUAL_AI_RATE_LIMIT_WINDOW_MS=60000
DUAL_AI_RATE_LIMIT_MAX=10
DUAL_AI_A_PROVIDER=openai
DUAL_AI_A_MODEL=
DUAL_AI_B_PROVIDER=openai
DUAL_AI_B_MODEL=
ANTHROPIC_API_KEY=
ANTHROPIC_MAX_TOKENS=4096
OLLAMA_BASE_URL=http://127.0.0.1:11434
