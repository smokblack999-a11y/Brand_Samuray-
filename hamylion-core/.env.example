# Copy to .env and replace every placeholder with unique deployment secrets.
# Do not commit .env.
POSTGRES_DB=hamylion
POSTGRES_USER=hamylion_app
POSTGRES_PASSWORD=REPLACE_WITH_A_LONG_RANDOM_PASSWORD
HAMYLION_API_KEY=REPLACE_WITH_A_DIFFERENT_LONG_RANDOM_API_KEY

# Keep the API bound to loopback unless a reverse proxy/firewall is configured.
HAMYLION_BIND_ADDRESS=127.0.0.1
HAMYLION_PORT=8000
