# Obtain these credentials from https://my.telegram.org
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# Generate independent random values. Never commit real values.
TELEGRAM_CORE_API_KEY=
TELEGRAM_SESSION_KEY=

# Optional. Session ciphertext is stored outside the repository by default.
TELEGRAM_SESSION_FILE=./data/telegram-session.enc
TELEGRAM_CORE_PORT=8790
TELEGRAM_CORE_HOST=127.0.0.1
NODE_ENV=development
